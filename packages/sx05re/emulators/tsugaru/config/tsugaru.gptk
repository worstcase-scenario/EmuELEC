# Tsugaru (FM Towns) gptokeyb configuration.

# I N S T R U C T I O N S :
#
# If a game needs special keys (for example A for UP, Z for DOWN etc.), change the mapping table beneath accordingly.
#
# Then SAVE this file under the game's name. For example: Alltynex.gptk
#
# The correct filepath for the game-gptk file is: /emuelec/configs/tsugaru/gptk
#
# For example: /emuelec/configs/tsugaru/gptk/Alltynex.gptk
#
# tsugarustart.sh will automatically load the respective gptk file when starting the game.
#
# If no game-specific gptk file is found, the emulator will always use "tsugaru.gptk" in /emuelec/configs/tsugaru/gptk
#
# Default pad mode is -GAMEPORT0 KEY: Z/X = A/B, A = RUN, S = SELECT, arrow keys = D-Pad.
#
# Other pad modes (e.g. the 6-button Capcom pad for Street Fighter II) can be set per game with the
# OPTS Maker in the setup menu: choose the game and set "Gameport 0", e.g. to PHYS0CAPCOM.
# The controller is then read directly by Tsugaru. The .opts file is saved next to the ROM.
#----------------------------------------------------------------------------------------------------------------------------
back = s
start = a
select =
a = z
b = x
x = enter
y = esc

l1 = mouse_left
l2 =
r1 = mouse_right
r2 =

up = up
down = down
left = left
right = right

left_analog_left = left
left_analog_right = right
left_analog_up = up
left_analog_down = down

right_analog_up = mouse_movement_up
right_analog_down = mouse_movement_down
right_analog_left = mouse_movement_left
right_analog_right = mouse_movement_right
mouse_scale = 1500
mouse_delay = 16
