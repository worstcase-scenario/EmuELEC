+    static bool list_packages_handler(common::arg_parser *, void *userdata, std::string *err) {
+        auto *emu = reinterpret_cast<emulator_state *>(userdata);
+        manager::packages *pkgmngr = emu->symsys->get_packages();
+
+        for (auto &[uid, pkg] : *pkgmngr) {
+            if (pkg.index != 0)
+                continue;
+            std::cout << "0x" << std::hex << pkg.uid << std::dec << " : "
+                      << common::ucs2_to_utf8(pkg.package_name) << std::endl;
+        }
+        return false;
+    }
