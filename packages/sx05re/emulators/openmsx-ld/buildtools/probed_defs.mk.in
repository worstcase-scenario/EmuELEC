HAVE_ALSA_H:=true
HAVE_ALSA_LIB:=true
ALSA_CFLAGS:=
ALSA_LDFLAGS:=-lasound
HAVE_FREETYPE_H:=true
HAVE_FREETYPE_LIB:=true
FREETYPE_CFLAGS:=-I@SYSROOT@/usr/include/freetype2 -I@SYSROOT@/usr/include
FREETYPE_LDFLAGS:=-L@SYSROOT@/usr/lib -lfreetype
HAVE_GL_H:=true
HAVE_GL_LIB:=true
GL_CFLAGS:=
GL_LDFLAGS:=-lGL
HAVE_GLEW_H:=true
HAVE_GLEW_LIB:=true
GLEW_CFLAGS:=
GLEW_LDFLAGS:=-lGLEW -lGL
HAVE_OGG_H:=true
HAVE_OGG_LIB:=true
OGG_CFLAGS:=
OGG_LDFLAGS:=-logg
HAVE_PNG_H:=true
HAVE_PNG_LIB:=true
PNG_CFLAGS:=-I@SYSROOT@/usr/include/libpng16
PNG_LDFLAGS:=-lpng16
HAVE_SDL2_H:=true
HAVE_SDL2_LIB:=true
SDL2_CFLAGS:=-I@SYSROOT@/usr/include/SDL2 -D_REENTRANT
SDL2_LDFLAGS:=-lSDL2
HAVE_SDL2_TTF_H:=true
HAVE_SDL2_TTF_LIB:=true
SDL2_TTF_CFLAGS:=-I@SYSROOT@/usr/include/SDL2
SDL2_TTF_LDFLAGS:=-lSDL2_ttf
HAVE_TCL_H:=true
HAVE_TCL_LIB:=true
TCL_CFLAGS:=
TCL_LDFLAGS:=-ltcl8.6
HAVE_THEORA_H:=true
HAVE_THEORA_LIB:=true
THEORA_CFLAGS:=
THEORA_LDFLAGS:=-ltheoradec
HAVE_VORBIS_H:=true
HAVE_VORBIS_LIB:=true
VORBIS_CFLAGS:=
VORBIS_LDFLAGS:=-lvorbis
HAVE_ZLIB_H:=true
HAVE_ZLIB_LIB:=true
ZLIB_CFLAGS:=
ZLIB_LDFLAGS:=-lz
HAVE_FTRUNCATE:=true
HAVE_MMAP:=true
