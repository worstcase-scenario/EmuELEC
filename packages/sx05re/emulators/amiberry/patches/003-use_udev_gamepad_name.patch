+// EmuELEC: RetroArch autoconfig files are named after the udev device name,
+// which can differ from the SDL joystick name
+static std::string get_udev_name(const std::string& path)
+{
+	const auto event = " " + path.substr(path.rfind('/') + 1) + " ";
+	std::ifstream devices("/proc/bus/input/devices");
+	std::string line, name;
+	while (std::getline(devices, line))
+	{
+		if (line.rfind("N: Name=\"", 0) == 0 && line.size() > 10)
+			name = line.substr(9, line.size() - 10);
+		else if (line.rfind("H: Handlers=", 0) == 0 && (" " + line.substr(12) + " ").find(event) != std::string::npos)
+			return name;
+	}
+	return {};
+}
