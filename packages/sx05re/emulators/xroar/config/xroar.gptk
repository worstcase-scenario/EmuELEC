# /storage/.config/emuelec/configs/xroar/gptk/xroar.gptk

# Controller buttons -> keyboard keys
back  = esc
start = enter

a = enter
b = space
x = 1
y = 2

# Shoulders/triggers/sticks -> keyboard keys (choose what you want)
l1 = j
l2 = n
l3 = x
r1 = r
r2 = n
r3 = c

# D-pad -> cursor keys
up = up
down = down
left = left
right = right

# Left analog as alternative to D-pad
left_analog_up = up
left_analog_down = down
left_analog_left = left
left_analog_right = right
