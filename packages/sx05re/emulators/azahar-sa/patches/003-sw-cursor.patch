+#include "common/sw_cursor.h"
 #include "common/assert.h"
 #include "common/logging/log.h"
 #include "common/memory_detect.h"
@@ -909,6 +910,22 @@ void RendererVulkan::DrawScreens(Frame* frame, const Layout::FramebufferLayout&
         }
     }
 
+    const int cx = Common::sw_cursor_x, cy = Common::sw_cursor_y;
+    if (cx >= 0 && cy >= 0 && cx + 12 <= static_cast<int>(layout.width) &&
+        cy + 12 <= static_cast<int>(layout.height)) {
+        scheduler.Record([cx, cy](vk::CommandBuffer cmdbuf) {
+            const auto clear = [&](int o, int s, float c) {
+                const vk::ClearAttachment att{vk::ImageAspectFlagBits::eColor, 0,
+                                              vk::ClearColorValue{std::array{c, c, c, 1.0f}}};
+                const vk::ClearRect rect{{{cx + o, cy + o}, {static_cast<u32>(s), static_cast<u32>(s)}},
+                                         0, 1};
+                cmdbuf.clearAttachments(att, rect);
+            };
+            clear(0, 12, 0.0f);
+            clear(2, 8, 1.0f);
+        });
+    }
+
     scheduler.Record([](vk::CommandBuffer cmdbuf) { cmdbuf.endRenderPass(); });
 }
 
