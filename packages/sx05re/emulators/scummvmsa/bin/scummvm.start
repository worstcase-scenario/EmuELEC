# Source predefined functions and variables
. /etc/profile

CONFIG_DIR="/storage/.config/scummvm"
ROM_DIR="/storage/roms/scummvm"
TMP_DIR="/tmp/scummvm"
GAME="$(basename "$2")"
GAME="${GAME%.*}"
RATMPCONF="/storage/.config/retroarch/retroarch.cfg"

create_svm(){
    mkdir -p "${TMP_DIR}"
    SDL_VIDEODRIVER=offscreen scummvm --list-targets | tail -n +3 | cut -d " " -f 1 | while read id; do
    [[ -z "${id}" ]] && continue
    echo "${id}" > "${TMP_DIR}/${id}.scummvm"
    echo "${id} has been added to ${ROM_DIR}/${id}.scummvm"
	done
    ls "${TMP_DIR}"/*.scummvm >/dev/null 2>&1 && cp -f "${TMP_DIR}"/*.scummvm "${ROM_DIR}"
    rm -rf "${TMP_DIR}"
	}

if [ ! -d "${CONFIG_DIR}" ]; then
 mkdir -p "${CONFIG_DIR}"
 cp -rf /usr/config/scummvm/* "${CONFIG_DIR}/"
fi

mkdir -p "${ROM_DIR}"

if [ -d "${CONFIG_DIR}/extra" ]; then
EXTRA="--extrapath=${CONFIG_DIR}/extra"
fi

case $1 in
"sa")
set_audio "fluidsynth"
scummvm --fullscreen --joystick=0 ${EXTRA} "${GAME}"
set_audio "pulseaudio"
;;
"libretro")
retroarch -L /tmp/cores/scummvm_libretro.so --config "${RATMPCONF}" "$2"
;;
"add")
SDL_VIDEODRIVER=offscreen scummvm --add --path="${ROM_DIR}" --recursive
mkdir -p /storage/roms/bios/
cp "${CONFIG_DIR}/scummvm.ini" /storage/roms/bios/scummvm.ini
;;
"create")
create_svm
;;
esac
