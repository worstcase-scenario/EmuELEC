Subject: [PATCH] Vulkan: framebuffer fetch via input attachment with rasterization order access

Uses VK_EXT_rasterization_order_attachment_access so drivers without dual
source blending (e.g. Mali) can emulate blending and logic ops in the shader.
---
diff --git a/Source/Core/VideoBackends/Vulkan/CommandBufferManager.cpp b/Source/Core/VideoBackends/Vulkan/CommandBufferManager.cpp
index c82417eb8c..8ea3a0b5c5 100644
--- a/Source/Core/VideoBackends/Vulkan/CommandBufferManager.cpp
+++ b/Source/Core/VideoBackends/Vulkan/CommandBufferManager.cpp
@@ -163,7 +163,7 @@ VkDescriptorPool CommandBufferManager::CreateDescriptorPool(u32 max_descriptor_s
    * UNIFORM_TEXEL_BUFFER: 3
    * STORAGE_IMAGE: 1
    */
-  const std::array<VkDescriptorPoolSize, 5> pool_sizes{{
+  const std::array<VkDescriptorPoolSize, 6> pool_sizes{{
       {VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC, max_descriptor_sets * 3},
       {VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
        max_descriptor_sets *
@@ -172,6 +172,7 @@ VkDescriptorPool CommandBufferManager::CreateDescriptorPool(u32 max_descriptor_s
       {VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, max_descriptor_sets * 2},
       {VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER, max_descriptor_sets * 3},
       {VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, max_descriptor_sets * 1},
+      {VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT, max_descriptor_sets * 1},
   }};
 
   const VkDescriptorPoolCreateInfo pool_create_info = {
diff --git a/Source/Core/VideoBackends/Vulkan/Constants.h b/Source/Core/VideoBackends/Vulkan/Constants.h
index afb70e0875..8d2ef052c1 100644
--- a/Source/Core/VideoBackends/Vulkan/Constants.h
+++ b/Source/Core/VideoBackends/Vulkan/Constants.h
@@ -75,6 +75,9 @@ enum UNIFORM_BUFFER_DESCRIPTOR_SET_BINDING
   NUM_UBO_DESCRIPTOR_SET_BINDINGS
 };
 
+// Binding of the framebuffer fetch input attachment in the standard sampler set.
+constexpr u32 FBFETCH_INPUT_ATTACHMENT_BINDING = 16;
+
 // Maximum number of attributes per vertex (we don't have any more than this?)
 constexpr u32 MAX_VERTEX_ATTRIBUTES = 16;
 
diff --git a/Source/Core/VideoBackends/Vulkan/ObjectCache.cpp b/Source/Core/VideoBackends/Vulkan/ObjectCache.cpp
index 965721decf..faa422c6ea 100644
--- a/Source/Core/VideoBackends/Vulkan/ObjectCache.cpp
+++ b/Source/Core/VideoBackends/Vulkan/ObjectCache.cpp
@@ -181,11 +181,21 @@ bool ObjectCache::CreateDescriptorSetLayouts()
 
   std::array<VkDescriptorSetLayoutBinding, 4> ubo_bindings = standard_ubo_bindings;
 
+  // Framebuffer fetch reads the color attachment through an input attachment after the samplers.
+  std::vector<VkDescriptorSetLayoutBinding> sampler_bindings(standard_sampler_bindings.begin(),
+                                                             standard_sampler_bindings.end());
+  if (g_vulkan_context->SupportsFramebufferFetchInputAttachment())
+  {
+    sampler_bindings.push_back({FBFETCH_INPUT_ATTACHMENT_BINDING,
+                                VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT, 1,
+                                VK_SHADER_STAGE_FRAGMENT_BIT});
+  }
+
   std::array<VkDescriptorSetLayoutCreateInfo, NUM_DESCRIPTOR_SET_LAYOUTS> create_infos{{
       {VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO, nullptr, 0,
        static_cast<u32>(ubo_bindings.size()), ubo_bindings.data()},
       {VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO, nullptr, 0,
-       static_cast<u32>(standard_sampler_bindings.size()), standard_sampler_bindings.data()},
+       static_cast<u32>(sampler_bindings.size()), sampler_bindings.data()},
       {VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO, nullptr, 0,
        static_cast<u32>(standard_ssbo_bindings.size()), standard_ssbo_bindings.data()},
       {VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO, nullptr, 0,
@@ -423,11 +433,16 @@ VkRenderPass ObjectCache::GetRenderPass(VkFormat color_format, VkFormat depth_fo
   VkAttachmentReference* depth_reference_ptr = nullptr;
   std::vector<VkAttachmentDescription> attachments;
   std::vector<VkAttachmentReference> color_attachment_references;
+  // With framebuffer fetch, the first color attachment is also the subpass input attachment.
+  const bool fbfetch = color_format != VK_FORMAT_UNDEFINED &&
+                       g_vulkan_context->SupportsFramebufferFetchInputAttachment();
+  const VkAttachmentReference input_reference = {0, VK_IMAGE_LAYOUT_GENERAL};
   if (color_format != VK_FORMAT_UNDEFINED)
   {
     VkAttachmentReference color_reference;
     color_reference.attachment = static_cast<uint32_t>(attachments.size());
-    color_reference.layout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    color_reference.layout =
+        fbfetch ? VK_IMAGE_LAYOUT_GENERAL : VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
     color_attachment_references.push_back(std::move(color_reference));
     attachments.push_back({0, color_format, static_cast<VkSampleCountFlagBits>(multisamples),
                            load_op, VK_ATTACHMENT_STORE_OP_STORE, VK_ATTACHMENT_LOAD_OP_DONT_CARE,
@@ -461,10 +476,10 @@ VkRenderPass ObjectCache::GetRenderPass(VkFormat color_format, VkFormat depth_fo
   }
 
   VkSubpassDescription subpass = {
-      0,
+      fbfetch ? VK_SUBPASS_DESCRIPTION_RASTERIZATION_ORDER_ATTACHMENT_COLOR_ACCESS_BIT_EXT : 0u,
       VK_PIPELINE_BIND_POINT_GRAPHICS,
-      0,
-      nullptr,
+      fbfetch ? 1u : 0u,
+      fbfetch ? &input_reference : nullptr,
       static_cast<uint32_t>(color_attachment_references.size()),
       color_attachment_references.empty() ? nullptr : color_attachment_references.data(),
       nullptr,
diff --git a/Source/Core/VideoBackends/Vulkan/ShaderCompiler.cpp b/Source/Core/VideoBackends/Vulkan/ShaderCompiler.cpp
index 13dbe0e0b7..8d6ef9ea98 100644
--- a/Source/Core/VideoBackends/Vulkan/ShaderCompiler.cpp
+++ b/Source/Core/VideoBackends/Vulkan/ShaderCompiler.cpp
@@ -6,6 +6,8 @@
 #include <cstddef>
 #include <string>
 
+#include <fmt/format.h>
+
 #include "VideoBackends/Vulkan/VulkanContext.h"
 #include "VideoCommon/DriverDetails.h"
 #include "VideoCommon/ShaderCompileUtils.h"
@@ -110,6 +112,14 @@ static std::string GetShaderCode(std::string_view source, std::string_view heade
     }
     if (DriverDetails::HasBug(DriverDetails::BUG_BROKEN_SUBGROUP_OPS_WITH_DISCARD))
       full_source_code.append("#define BROKEN_SUBGROUP_WITH_DISCARD 1\n");
+    if (g_vulkan_context->SupportsFramebufferFetchInputAttachment())
+    {
+      full_source_code.append(fmt::format(
+          "#undef INPUT_ATTACHMENT_BINDING\n"
+          "#define INPUT_ATTACHMENT_BINDING(x, y, z) "
+          "layout(set = 1, binding = {}, input_attachment_index = z)\n",
+          FBFETCH_INPUT_ATTACHMENT_BINDING));
+    }
     full_source_code.append(source);
   }
 
diff --git a/Source/Core/VideoBackends/Vulkan/StateTracker.cpp b/Source/Core/VideoBackends/Vulkan/StateTracker.cpp
index 623b01f3ae..1d25345d62 100644
--- a/Source/Core/VideoBackends/Vulkan/StateTracker.cpp
+++ b/Source/Core/VideoBackends/Vulkan/StateTracker.cpp
@@ -130,7 +130,21 @@ void StateTracker::SetFramebuffer(VKFramebuffer* framebuffer)
 {
   // Should not be changed within a render pass.
   ASSERT(!InRenderPass());
+  const bool framebuffer_changed = m_framebuffer != framebuffer;
   m_framebuffer = framebuffer;
+
+  // Framebuffer fetch reads the current color attachment through the sampler descriptor set.
+  if (g_vulkan_context->SupportsFramebufferFetchInputAttachment())
+  {
+    const AbstractTexture* color = framebuffer ? framebuffer->GetColorAttachment() : nullptr;
+    const VkImageView view =
+        color ? static_cast<const VKTexture*>(color)->GetView() : VK_NULL_HANDLE;
+    if (framebuffer_changed || m_bindings.fbfetch_input.imageView != view)
+    {
+      m_bindings.fbfetch_input = {VK_NULL_HANDLE, view, VK_IMAGE_LAYOUT_GENERAL};
+      m_dirty_flags |= DIRTY_FLAG_GX_SAMPLERS;
+    }
+  }
 }
 
 void StateTracker::SetPipeline(const VKPipeline* pipeline)
@@ -478,6 +492,7 @@ void StateTracker::UpdateGXDescriptorSet()
 {
   const size_t MAX_DESCRIPTOR_WRITES = NUM_UBO_DESCRIPTOR_SET_BINDINGS +  // UBO
                                        1 +                                // Samplers
+                                       1 +                                // FB fetch input
                                        2;                                 // SSBO
   std::array<VkWriteDescriptorSet, MAX_DESCRIPTOR_WRITES> writes;
   u32 num_writes = 0;
@@ -533,6 +548,19 @@ void StateTracker::UpdateGXDescriptorSet()
                             m_bindings.samplers.data(),
                             nullptr,
                             nullptr};
+    if (m_bindings.fbfetch_input.imageView != VK_NULL_HANDLE)
+    {
+      writes[num_writes++] = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+                              nullptr,
+                              m_gx_descriptor_sets[1],
+                              FBFETCH_INPUT_ATTACHMENT_BINDING,
+                              0,
+                              1,
+                              VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT,
+                              &m_bindings.fbfetch_input,
+                              nullptr,
+                              nullptr};
+    }
     m_dirty_flags = (m_dirty_flags & ~DIRTY_FLAG_GX_SAMPLERS) | DIRTY_FLAG_DESCRIPTOR_SETS;
   }
 
diff --git a/Source/Core/VideoBackends/Vulkan/StateTracker.h b/Source/Core/VideoBackends/Vulkan/StateTracker.h
index da0e4d8387..9532afb840 100644
--- a/Source/Core/VideoBackends/Vulkan/StateTracker.h
+++ b/Source/Core/VideoBackends/Vulkan/StateTracker.h
@@ -143,6 +143,7 @@ private:
     VkDescriptorBufferInfo utility_ubo_binding;
     u32 utility_ubo_offset;
     std::array<VkDescriptorImageInfo, VideoCommon::MAX_PIXEL_SHADER_SAMPLERS> samplers;
+    VkDescriptorImageInfo fbfetch_input;
     std::array<VkBufferView, NUM_COMPUTE_TEXEL_BUFFERS> texel_buffers;
     VkDescriptorBufferInfo ssbo;
     VkDescriptorBufferInfo gx_uber_vertex_ssbo;
diff --git a/Source/Core/VideoBackends/Vulkan/VKMain.cpp b/Source/Core/VideoBackends/Vulkan/VKMain.cpp
index d2bb68a6ce..373d2670c0 100644
--- a/Source/Core/VideoBackends/Vulkan/VKMain.cpp
+++ b/Source/Core/VideoBackends/Vulkan/VKMain.cpp
@@ -184,6 +184,8 @@ bool VideoBackend::Initialize(const WindowSystemInfo& wsi)
       &g_backend_info, g_vulkan_context->GetPhysicalDevice(), g_vulkan_context->GetDeviceInfo());
   g_backend_info.bSupportsExclusiveFullscreen =
       enable_surface && g_vulkan_context->SupportsExclusiveFullscreen(wsi, surface);
+  if (g_vulkan_context->SupportsFramebufferFetchInputAttachment())
+    g_backend_info.bSupportsFramebufferFetch = true;
 
   UpdateActiveConfig();
 
diff --git a/Source/Core/VideoBackends/Vulkan/VKPipeline.cpp b/Source/Core/VideoBackends/Vulkan/VKPipeline.cpp
index 6dbd9e5bfc..4c1116e1e2 100644
--- a/Source/Core/VideoBackends/Vulkan/VKPipeline.cpp
+++ b/Source/Core/VideoBackends/Vulkan/VKPipeline.cpp
@@ -365,6 +365,11 @@ std::unique_ptr<VKPipeline> VKPipeline::Create(const AbstractPipelineConfig& con
   VkPipelineColorBlendStateCreateInfo blend_state =
       GetVulkanColorBlendState(config.blending_state, blend_attachment_states.data(),
                                static_cast<uint32_t>(blend_attachment_states.size()));
+  if (g_vulkan_context->SupportsFramebufferFetchInputAttachment() &&
+      config.framebuffer_state.color_texture_format != AbstractTextureFormat::Undefined)
+  {
+    blend_state.flags |= VK_PIPELINE_COLOR_BLEND_STATE_CREATE_RASTERIZATION_ORDER_ATTACHMENT_ACCESS_BIT_EXT;
+  }
 
   static const VkDepthClampRangeEXT clamp_range = {0.0f, MAX_EFB_DEPTH};
   static const VkPipelineViewportDepthClampControlCreateInfoEXT depth_clamp_state = {
diff --git a/Source/Core/VideoBackends/Vulkan/VKSwapChain.cpp b/Source/Core/VideoBackends/Vulkan/VKSwapChain.cpp
index dbcdc49452..c9e26e6b68 100644
--- a/Source/Core/VideoBackends/Vulkan/VKSwapChain.cpp
+++ b/Source/Core/VideoBackends/Vulkan/VKSwapChain.cpp
@@ -474,6 +474,8 @@ bool SwapChain::CreateSwapChain()
     ERROR_LOG_FMT(VIDEO, "Vulkan: Swap chain does not support usage as color attachment");
     return false;
   }
+  if (g_vulkan_context->SupportsFramebufferFetchInputAttachment())
+    image_usage |= VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT;
 
   // Select the number of image layers for Quad-Buffered stereoscopy
   uint32_t image_layers = g_ActiveConfig.stereo_mode == StereoMode::QuadBuffer ? 2 : 1;
diff --git a/Source/Core/VideoBackends/Vulkan/VKTexture.cpp b/Source/Core/VideoBackends/Vulkan/VKTexture.cpp
index ee6a1b77b3..f6f817ded7 100644
--- a/Source/Core/VideoBackends/Vulkan/VKTexture.cpp
+++ b/Source/Core/VideoBackends/Vulkan/VKTexture.cpp
@@ -64,6 +64,11 @@ std::unique_ptr<VKTexture> VKTexture::Create(const TextureConfig& tex_config, st
   {
     usage |= IsDepthFormat(tex_config.format) ? VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT :
                                                 VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+    if (!IsDepthFormat(tex_config.format) &&
+        g_vulkan_context->SupportsFramebufferFetchInputAttachment())
+    {
+      usage |= VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT;
+    }
   }
   if (tex_config.IsComputeImage())
     usage |= VK_IMAGE_USAGE_STORAGE_BIT;
diff --git a/Source/Core/VideoBackends/Vulkan/VulkanContext.cpp b/Source/Core/VideoBackends/Vulkan/VulkanContext.cpp
index 22683892c6..12cc5b2860 100644
--- a/Source/Core/VideoBackends/Vulkan/VulkanContext.cpp
+++ b/Source/Core/VideoBackends/Vulkan/VulkanContext.cpp
@@ -685,6 +685,12 @@ bool VulkanContext::SelectDeviceExtensions(bool enable_surface)
         AddExtension(VK_EXT_DEPTH_RANGE_UNRESTRICTED_EXTENSION_NAME, false);
   }
 
+  if (m_supports_fbfetch_input_attachment)
+  {
+    m_supports_fbfetch_input_attachment =
+        AddExtension(VK_EXT_RASTERIZATION_ORDER_ATTACHMENT_ACCESS_EXTENSION_NAME, false);
+  }
+
   return true;
 }
 
@@ -799,9 +805,46 @@ bool VulkanContext::CreateDevice(VkSurfaceKHR surface, bool enable_validation_la
   }
   device_info.pQueueCreateInfos = queue_infos.data();
 
+#ifndef __APPLE__
+  // Framebuffer fetch via a color input attachment needs rasterization order access, and the
+  // swap chain images must allow input attachment usage as all color render passes declare one.
+  VkPhysicalDeviceRasterizationOrderAttachmentAccessFeaturesEXT raster_order_features = {};
+  raster_order_features.sType =
+      VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_RASTERIZATION_ORDER_ATTACHMENT_ACCESS_FEATURES_EXT;
+  if (vkGetPhysicalDeviceFeatures2 && m_device_info.apiVersion >= VK_API_VERSION_1_1)
+  {
+    VkPhysicalDeviceFeatures2 features2 = {};
+    features2.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2;
+    features2.pNext = &raster_order_features;
+    vkGetPhysicalDeviceFeatures2(m_physical_device, &features2);
+    m_supports_fbfetch_input_attachment =
+        raster_order_features.rasterizationOrderColorAttachmentAccess == VK_TRUE;
+  }
+  if (m_supports_fbfetch_input_attachment && surface != VK_NULL_HANDLE)
+  {
+    VkSurfaceCapabilitiesKHR caps;
+    m_supports_fbfetch_input_attachment =
+        vkGetPhysicalDeviceSurfaceCapabilitiesKHR(m_physical_device, surface, &caps) ==
+            VK_SUCCESS &&
+        (caps.supportedUsageFlags & VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT);
+  }
+#endif
+
   if (!SelectDeviceExtensions(surface != VK_NULL_HANDLE))
     return false;
 
+#ifndef __APPLE__
+  if (m_supports_fbfetch_input_attachment)
+  {
+    raster_order_features.pNext = nullptr;
+    raster_order_features.rasterizationOrderColorAttachmentAccess = VK_TRUE;
+    raster_order_features.rasterizationOrderDepthAttachmentAccess = VK_FALSE;
+    raster_order_features.rasterizationOrderStencilAttachmentAccess = VK_FALSE;
+    device_info.pNext = &raster_order_features;
+    INFO_LOG_FMT(VIDEO, "Using input attachments with rasterization order for framebuffer fetch.");
+  }
+#endif
+
   // convert std::string list to a char pointer list which we can feed in
   std::vector<const char*> extension_name_pointers;
   for (const std::string& name : m_device_extensions)
diff --git a/Source/Core/VideoBackends/Vulkan/VulkanContext.h b/Source/Core/VideoBackends/Vulkan/VulkanContext.h
index f59c7421f4..5bfcbe983b 100644
--- a/Source/Core/VideoBackends/Vulkan/VulkanContext.h
+++ b/Source/Core/VideoBackends/Vulkan/VulkanContext.h
@@ -108,6 +108,8 @@ public:
   bool SupportsPreciseOcclusionQueries() const { return m_device_info.occlusionQueryPrecise; }
   u32 GetShaderSubgroupSize() const { return m_device_info.subgroupSize; }
   bool SupportsShaderSubgroupOperations() const { return m_device_info.shaderSubgroupOperations; }
+  // Framebuffer fetch through a color input attachment with rasterization order access.
+  bool SupportsFramebufferFetchInputAttachment() const { return m_supports_fbfetch_input_attachment; }
 
   // Helpers for getting constants
   VkDeviceSize GetUniformBufferAlignment() const
@@ -155,6 +157,7 @@ private:
   VkDebugUtilsMessengerEXT m_debug_utils_messenger = VK_NULL_HANDLE;
 
   PhysicalDeviceInfo m_device_info;
+  bool m_supports_fbfetch_input_attachment = false;
 
   std::vector<std::string> m_device_extensions;
 };
