@@ -0,0 +1,38 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <gbm.h>
+#include <xf86drmMode.h>
+
+#include "Common/CommonTypes.h"
+#include "Common/GL/GLInterface/EGL.h"
+
+// EGL on GBM, presented with KMS page flips.
+class GLContextEGLDRM final : public GLContextEGL
+{
+public:
+  ~GLContextEGLDRM() override;
+
+  void Swap() override;
+
+protected:
+  EGLDisplay OpenEGLDisplay() override;
+  EGLNativeWindowType GetEGLNativeWindow(EGLConfig config) override;
+
+private:
+  bool OpenDRM();
+  u32 GetFramebuffer(gbm_bo* bo);
+  void WaitForFlip();
+
+  int m_fd = -1;
+  u32 m_connector = 0;
+  drmModeModeInfo m_mode = {};
+  drmModeCrtc* m_saved_crtc = nullptr;
+  gbm_device* m_device = nullptr;
+  gbm_surface* m_surface = nullptr;
+  gbm_bo* m_bo = nullptr;
+  gbm_bo* m_next_bo = nullptr;
+  bool m_flip_pending = false;
+};
