diff --git a/Source/Core/Common/GL/GLInterface/EGLDRM.cpp b/Source/Core/Common/GL/GLInterface/EGLDRM.cpp
new file mode 100644
index 0000000000..da3caef898
--- /dev/null
+++ b/Source/Core/Common/GL/GLInterface/EGLDRM.cpp
@@ -0,0 +1,181 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "Common/GL/GLInterface/EGLDRM.h"
+
+#include <cstdint>
+#include <string>
+
+#include <fcntl.h>
+#include <poll.h>
+#include <unistd.h>
+#include <xf86drm.h>
+
+#include "Common/Logging/Log.h"
+
+GLContextEGLDRM::~GLContextEGLDRM()
+{
+  // The EGL surface and display have to go before the GBM objects they use.
+  DestroyWindowSurface();
+  DestroyContext();
+
+  WaitForFlip();
+  if (m_saved_crtc)
+  {
+    drmModeSetCrtc(m_fd, m_saved_crtc->crtc_id, m_saved_crtc->buffer_id, m_saved_crtc->x,
+                   m_saved_crtc->y, &m_connector, 1, &m_saved_crtc->mode);
+    drmModeFreeCrtc(m_saved_crtc);
+  }
+  if (m_bo)
+    gbm_surface_release_buffer(m_surface, m_bo);
+  if (m_surface)
+    gbm_surface_destroy(m_surface);
+  if (m_device)
+    gbm_device_destroy(m_device);
+  if (m_fd >= 0)
+    close(m_fd);
+}
+
+// Uses the first connector that is currently driven, with its current mode.
+bool GLContextEGLDRM::OpenDRM()
+{
+  for (int i = 0; i < 4 && !m_saved_crtc; ++i)
+  {
+    m_fd = open(("/dev/dri/card" + std::to_string(i)).c_str(), O_RDWR | O_CLOEXEC);
+    drmModeRes* res = m_fd >= 0 ? drmModeGetResources(m_fd) : nullptr;
+    for (int c = 0; res && c < res->count_connectors && !m_saved_crtc; ++c)
+    {
+      drmModeConnector* conn = drmModeGetConnector(m_fd, res->connectors[c]);
+      drmModeEncoder* enc = conn && conn->connection == DRM_MODE_CONNECTED ?
+                                drmModeGetEncoder(m_fd, conn->encoder_id) :
+                                nullptr;
+      drmModeCrtc* crtc = enc ? drmModeGetCrtc(m_fd, enc->crtc_id) : nullptr;
+      if (crtc && crtc->mode_valid)
+      {
+        m_saved_crtc = crtc;
+        m_connector = conn->connector_id;
+        m_mode = crtc->mode;
+      }
+      else
+      {
+        drmModeFreeCrtc(crtc);
+      }
+      drmModeFreeEncoder(enc);
+      drmModeFreeConnector(conn);
+    }
+    drmModeFreeResources(res);
+    if (!m_saved_crtc && m_fd >= 0)
+    {
+      close(m_fd);
+      m_fd = -1;
+    }
+  }
+  return m_saved_crtc != nullptr;
+}
+
+EGLDisplay GLContextEGLDRM::OpenEGLDisplay()
+{
+  if (!OpenDRM())
+  {
+    ERROR_LOG_FMT(VIDEO, "No active DRM display found");
+    return EGL_NO_DISPLAY;
+  }
+  m_device = gbm_create_device(m_fd);
+  if (!m_device)
+    return EGL_NO_DISPLAY;
+
+  INFO_LOG_FMT(VIDEO, "Using EGL on GBM, {}x{} {}Hz", m_mode.hdisplay, m_mode.vdisplay,
+               m_mode.vrefresh);
+  return eglGetPlatformDisplay(EGL_PLATFORM_GBM_KHR, m_device, nullptr);
+}
+
+EGLNativeWindowType GLContextEGLDRM::GetEGLNativeWindow(EGLConfig config)
+{
+  if (!m_surface)
+  {
+    EGLint format = 0;
+    if (!eglGetConfigAttrib(m_egl_display, config, EGL_NATIVE_VISUAL_ID, &format) || !format)
+      format = GBM_FORMAT_XRGB8888;
+    m_surface = gbm_surface_create(m_device, m_mode.hdisplay, m_mode.vdisplay, format,
+                                   GBM_BO_USE_SCANOUT | GBM_BO_USE_RENDERING);
+  }
+  return reinterpret_cast<EGLNativeWindowType>(m_surface);
+}
+
+u32 GLContextEGLDRM::GetFramebuffer(gbm_bo* bo)
+{
+  if (void* data = gbm_bo_get_user_data(bo))
+    return static_cast<u32>(reinterpret_cast<uintptr_t>(data));
+
+  // Scan out without alpha, the memory layout is the same.
+  u32 format = gbm_bo_get_format(bo);
+  if (format == GBM_FORMAT_ARGB8888)
+    format = GBM_FORMAT_XRGB8888;
+  else if (format == GBM_FORMAT_ABGR8888)
+    format = GBM_FORMAT_XBGR8888;
+
+  const u32 handles[4] = {gbm_bo_get_handle(bo).u32};
+  const u32 pitches[4] = {gbm_bo_get_stride(bo)};
+  const u32 offsets[4] = {};
+  u32 fb = 0;
+  if (drmModeAddFB2(m_fd, gbm_bo_get_width(bo), gbm_bo_get_height(bo), format, handles, pitches,
+                    offsets, &fb, 0))
+  {
+    ERROR_LOG_FMT(VIDEO, "drmModeAddFB2 failed");
+    return 0;
+  }
+  gbm_bo_set_user_data(bo, reinterpret_cast<void*>(uintptr_t{fb}), [](gbm_bo* b, void* data) {
+    drmModeRmFB(gbm_device_get_fd(gbm_bo_get_device(b)),
+                static_cast<u32>(reinterpret_cast<uintptr_t>(data)));
+  });
+  return fb;
+}
+
+void GLContextEGLDRM::WaitForFlip()
+{
+  drmEventContext ev = {};
+  ev.version = 2;
+  ev.page_flip_handler = [](int, unsigned int, unsigned int, unsigned int, void* data) {
+    static_cast<GLContextEGLDRM*>(data)->m_flip_pending = false;
+  };
+  pollfd pfd = {m_fd, POLLIN, 0};
+  while (m_flip_pending && poll(&pfd, 1, 100) > 0)
+    drmHandleEvent(m_fd, &ev);
+  m_flip_pending = false;
+
+  if (m_next_bo)
+  {
+    gbm_surface_release_buffer(m_surface, m_bo);
+    m_bo = m_next_bo;
+    m_next_bo = nullptr;
+  }
+}
+
+void GLContextEGLDRM::Swap()
+{
+  GLContextEGL::Swap();
+  gbm_bo* bo = gbm_surface_lock_front_buffer(m_surface);
+  if (!bo)
+    return;
+
+  const u32 fb = GetFramebuffer(bo);
+  WaitForFlip();
+  if (!m_bo)
+  {
+    if (drmModeSetCrtc(m_fd, m_saved_crtc->crtc_id, fb, 0, 0, &m_connector, 1, &m_mode))
+      ERROR_LOG_FMT(VIDEO, "drmModeSetCrtc failed");
+    m_bo = bo;
+  }
+  else if (drmModePageFlip(m_fd, m_saved_crtc->crtc_id, fb, DRM_MODE_PAGE_FLIP_EVENT, this) == 0)
+  {
+    m_next_bo = bo;
+    m_flip_pending = true;
+    // The next frame needs a free buffer. With only two buffers this waits for the flip.
+    if (!gbm_surface_has_free_buffers(m_surface))
+      WaitForFlip();
+  }
+  else
+  {
+    gbm_surface_release_buffer(m_surface, bo);
+  }
+}
